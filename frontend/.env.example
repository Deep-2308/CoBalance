# Frontend Environment Variables
# Copy this file to .env (or .env.development / .env.production) and fill in the values

# API Base URL (your backend server)
VITE_API_BASE_URL=http://localhost:5000/api

# Authentication Mode
# Set to 'true' for mock auth (no backend required)
# Set to 'false' for real backend authentication
VITE_USE_MOCK_AUTH=false

# Development Mode Flag
VITE_DEV_MODE=true
